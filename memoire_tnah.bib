  shorttitle = {{{ViViT}}},
  author = {Arnab, Anurag and Dehghani, Mostafa and Heigold, Georg and Sun, Chen and Lučić, Mario and Schmid, Cordelia},
  year = 2021,
  month = nov,
  number = {arXiv:2103.15691},
