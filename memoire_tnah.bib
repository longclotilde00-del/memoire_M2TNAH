  author = {Brostow, Gabriel J. and Fauqueur, Julien and Cipolla, Roberto},
  year = 2009,
  month = jan,
  journal = {Pattern Recognition Letters},
  series = {Video-Based {{Object}} and {{Event Analysis}}},
  volume = {30},
